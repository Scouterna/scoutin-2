// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// We might want to store the configuration in the database and link it to the
// checkin session to allow for changing the configuration without messing up
// existing sessions.
// model CheckinStepConfig {}

// Local admin account. Authenticates the admin interface (username + password);
// `roles` gates access (the "admin" role is required today).
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique
  passwordHash String
  roles        String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Kiosk {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  keyHash    String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

model KioskSetupToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model CheckinLink {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configFile String
  params     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A blocklist entry. Groups a person's identifiers so removing via any one of
// them removes the whole block (cascade). Intentionally stores NO participant
// reference and NO raw identifier - only the doubly-hashed values in
// BlockedIdentifier - so the table cannot be joined back to a person.
model Block {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime            @default(now())
  // Optional, admin-visible free text. Not anonymous - keep it non-identifying.
  reason      String?
  identifiers BlockedIdentifier[]
}

model BlockedIdentifier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // hashBlockValue(hashLookupValue(identifier)): a second HMAC under a separate
  // key over the existing lookup hash. Reversing requires that key.
  blockHash String   @unique
  blockId   String   @db.Uuid
  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Generic, append-only action log. `details` is free-form per action but MUST
// NOT contain identifiers/hashes for blocklist actions (anonymity).
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  actor     String?
  action    String
  details   Json?
}

model CheckinSession {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configFile String
  params     Json                     @default("{}")
  stepData   CheckinSessionStepData[]

  actor CheckinActor?

  subjects CheckinSubject[]

  completedAt DateTime?
  // Set when the session is actively aborted (e.g. inactivity timeout).
  // Mutually exclusive with completedAt in practice.
  abortedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckinSessionStepData {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The step that was used
  stepId          String
  // The user defined ID in the step config
  idInFlow        String?
  // The inputs provided in the `with` field in the step config after evaluation.
  evaluatedInputs Json

  outputs       Json?
  completedAt   DateTime?
  autoCompleted Boolean   @default(false)

  sessionId String         @db.Uuid
  session   CheckinSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckinSubject {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  checkinSession   CheckinSession @relation(fields: [checkinSessionId], references: [id], onDelete: Cascade)
  checkinSessionId String         @db.Uuid

  participant   Participant @relation(fields: [participantId], references: [id])
  participantId String      @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckinActor {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  participant   Participant? @relation(fields: [participantId], references: [id])
  participantId String?      @db.Uuid

  checkinSession CheckinSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String         @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Participant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // lookupValues is an array of hashes that can be used to lookup the participant.
  lookupValues   String[]
  // dataSource determines where the participant information came from. A participant can be present in multiple data sources.
  dataSource     String
  // The ID of the participant in the data source.
  idInDataSource String

  firstName                String
  lastName                 String
  subGroup                 String?
  preliminaryCheckedInAt   DateTime?
  confirmedCheckedInAt     DateTime?

  // Arbitrary per-key data written by import enrichers (never flat-merged;
  // each enricher owns its own key). See registerImportEnricher.
  metadata     Json?
  // Per-source import failure reasons, keyed by failure source: "provider"
  // for raw import/validation failures, or the enricher's registry name for
  // enricher failures. The single source of truth for "does this row have an
  // import error": a non-empty object means at least one source failed; SQL
  // NULL (never flagged) or an empty object {} (self-healed) means clean.
  // Each writer only ever touches its own key, so multiple simultaneous
  // failures are recorded and cleared independently.
  importErrors Json?
  // Set when this participant was cancelled/removed from the data source
  // after a previous successful import. Cleared automatically if they
  // reappear in a later import. Row is kept (not hard-deleted) to preserve
  // CheckinSubject/CheckinActor history.
  deletedAt    DateTime?

  participantGroup   ParticipantGroup? @relation(fields: [participantGroupId], references: [id])
  participantGroupId String?           @db.Uuid

  checkinActors   CheckinActor[]
  checkinSubjects CheckinSubject[]

  @@unique([dataSource, idInDataSource])
  @@index([lookupValues], type: Gin)
}

model ParticipantGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSource     String
  idInDataSource String

  name String

  // Arbitrary per-key data written by import enrichers (never flat-merged;
  // each enricher owns its own key). See registerImportEnricher.
  metadata     Json?
  // Per-source import failure reasons, keyed by failure source: "provider"
  // for raw import/validation failures, or the enricher's registry name for
  // enricher failures. The single source of truth for "does this row have an
  // import error": a non-empty object means at least one source failed; SQL
  // NULL (never flagged) or an empty object {} (self-healed) means clean.
  // Each writer only ever touches its own key, so multiple simultaneous
  // failures are recorded and cleared independently.
  importErrors Json?

  participants Participant[]

  @@unique([dataSource, idInDataSource])
}
