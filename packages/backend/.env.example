DATABASE_URL="postgresql://postgres:supersecret@localhost:5432/scoutin?schema=public"
# In dev environments you can generate these using `openssl rand -hex 32`
TOKEN_SECRET=""
DATASOURCE_HASHING_SECRET=""
DATASOURCE_HASHING_SALT=""
# Separate key for the check-in blocklist. Kept distinct from DATASOURCE_HASHING_*
# on purpose: discarding/rotating it renders the entire blocklist inert.
BLOCKLIST_HASHING_SECRET=""

# Bootstrap admin for the /admin interface. Seeded on first boot ONLY when the
# user table is empty; ignored once any user exists (manage the rest via the
# admin "Användare" page). Log in with the username below, then change/remove
# these - they're first-run seeds, not the permanent credentials.
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD=""

# Optional: fatal | error | warn | info | debug | trace | silent
# Defaults to "debug" in development and "info" in production
# LOG_LEVEL=debug

SCOUTNET_GROUPS_GROUPS_KEY=""
SCOUTNET_GROUPS_PARTICIPANTS_KEY=""
SCOUTNET_GROUPS_CHECKIN_KEY=""
SCOUTNET_GROUPS_QUESTIONS_KEY=""

SCOUTNET_STAFF_GROUPS_KEY=""
SCOUTNET_STAFF_PARTICIPANTS_KEY=""
SCOUTNET_STAFF_CHECKIN_KEY=""
SCOUTNET_STAFF_QUESTIONS_KEY=""
