VITE_API_URL=http://localhost:3000

# Barcode scanner modes (kiosk identify screen). Build-time, like all VITE_ vars.
# Both modes are on unless set to "false".
# Markers: scanner sends ¤<data>¤.
VITE_SCANNER_MARKERS=true
# Enter: scanner types the data then presses Enter, keys <50 ms apart.
VITE_SCANNER_ENTER=true
